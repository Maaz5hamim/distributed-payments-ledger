{
  "uid": "payments-ledger",
  "title": "Distributed Payments Ledger",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed transfers per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (path) (rate(ledger_transfers_total{outcome=\"COMPLETED\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Transfer API p99 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le,path) (rate(ledger_transfer_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Reconciliation mismatches",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_reconciliation_mismatches{job=\"ledger-reconciler\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saga states",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_sagas{job=\"ledger-reconciler\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Outbox pending rows",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_outbox_unsent_rows{job=\"ledger-reconciler\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Outbox oldest age seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_outbox_lag_seconds{job=\"ledger-reconciler\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Reconciliation success",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_reconciliation_success{job=\"ledger-reconciler\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Stuck sagas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_saga_stuck{job=\"ledger-reconciler\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Transfer completion p99 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le,path) (rate(ledger_saga_completion_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Database pool connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "ledger_database_pool_connections",
          "refId": "A"
        }
      ]
    }
  ]
}